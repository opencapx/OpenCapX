{
  "name": "opencapx",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Desktop body for AI agents: intercepts their requests, keeps system permissions safe and controllable, gives any model the multimodal abilities it lacks, and extends with plugins and rules.",
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:check && tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:report": "node scripts/i18n-check.mjs --report",
    "i18n:scaffold": "node scripts/i18n-check.mjs --scaffold",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tauri-apps/cli": "^2.0.0",
    "@types/three": "^0.186.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "conventional-recommended-bump": "^12.1.0",
    "lefthook": "^2.1.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
