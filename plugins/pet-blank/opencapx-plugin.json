{
  "id": "com.opencapx.pet-blank",
  "name": "Pet Blank",
  "version": "0.1.0",
  "apiVersion": "1",
  "type": "pet",
  "runtime": {
    "type": "process",
    "command": "python3",
    "args": ["bin/pet_blank.py"]
  },
  "permissions": ["pet.animation"],
  "states": ["idle", "thinking", "working", "waiting", "success", "error", "sleeping"]
}
