  "description": "TypeScript SDK for writing OpenCapX plugins (JSON-RPC 2.0 over stdio)",
  "license": "Apache-2.0",
  "author": "OpenCapX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencapx/OpenCapX.git",
